# Server & Database Config
PORT=5000
MONGO_URI=mongodb://localhost:27017/ngo_db
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Media Storage Config
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Supabase Database & Auth Config
VITE_SUPABASE_URL=https://your_project_id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Payment Gateway (Razorpay Key ID - set to rzp_test_placeholder to test interactive modal without real API keys)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder

# Admin Portal Allowed Emails
VITE_ADMIN_ALLOWED_EMAILS=admin@example.com,foundation@example.com

# Gmail / SMTP Email Delivery Config (for sending 80G tax receipts and tickets)
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=587
VITE_SMTP_USER=your_gmail_address@gmail.com
VITE_SMTP_PASS=your_gmail_app_password_here
VITE_EMAIL_FROM="Srishree Vision Foundation <your_gmail_address@gmail.com>"
